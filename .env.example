# Firebase Client Configuration (Public - Safe to commit to repo)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase App Check (reCAPTCHA v3 Site Key)
VITE_FIREBASE_APP_CHECK_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# Set to true only when testing App Check on localhost with a debug token.
# When false/omitted, App Check is skipped on localhost to avoid 400 throttle errors.
VITE_ENABLE_APP_CHECK_IN_DEV=false
# Optional: Firebase App Check debug token for localhost (from Firebase Console > App Check).
# Use 'true' to auto-generate, or paste the debug token value.
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=your-debug-token

# Firebase Emulator Configuration (Development Only)
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=localhost:5001

# Feature Flags
VITE_ENABLE_OFFLINE_PERSISTENCE=true
VITE_ENABLE_FCM=true
# Web Push VAPID public key (Firebase Console > Project Settings > Cloud Messaging > Web Push certificates). Public; safe as VITE_*.
VITE_FIREBASE_FCM_VAPID_KEY=your-vapid-key
VITE_LOG_LEVEL=debug

# Supabase Free (C2 backend: Edge Functions + Storage, Singapore region, no card)
# Dashboard > Project Settings > API. Anon key is public; NEVER commit service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key