# Firebase Client Configuration (Public - Safe to commit to repo)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase App Check (reCAPTCHA v3 Site Key)
VITE_FIREBASE_APP_CHECK_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Firebase Emulator Configuration (Development Only)
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=localhost:5001

# Feature Flags
VITE_ENABLE_OFFLINE_PERSISTENCE=true
VITE_ENABLE_FCM=true
VITE_LOG_LEVEL=debug