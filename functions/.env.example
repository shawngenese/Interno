# Interno Cloud Functions Environment Variables
# Copy this file to .env and fill in your values

# JWT secret for signing QR attendance tokens (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
QR_JWT_SECRET=

# Brevo API key for sending emails (get from https://app.brevo.com > SMTP & API > API Keys)
# Free tier: 300 emails/day. Verify your sender address under Settings > Senders (confirmation-link email, no domain needed).
BREVO_API_KEY=

# Sender email address — must be a verified sender in Brevo (your personal Gmail is fine on the free plan)
EMAIL_FROM=geneseshawn@gmail.com

# Optional display name shown in the From field
EMAIL_FROM_NAME=Interno

# Optional app base URL used in invite links (defaults to https://interno-cec9f.web.app)
APP_URL=
