# Interno Cloud Functions Environment Variables
# Copy this file to .env and fill in your values

# JWT secret for signing QR attendance tokens (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
QR_JWT_SECRET=

# Resend API key for sending emails (get from https://resend.com - free tier: 100 emails/day)
RESEND_API_KEY=

# Sender email address (must be verified in Resend dashboard)
EMAIL_FROM=noreply@yourdomain.com
