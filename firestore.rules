rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // Helper Functions
    //
    // IMPORTANT: All role/field lookups use request.auth.token
    // (custom claims) instead of get(users/{uid}).
    // Using get() on users/{uid} from within ANY rule creates a
    // circular get() dependency: the users rule calls isAdmin()
    // → getUserData() → get(users/{uid}) → re-enters the users
    // rule → infinite recursion → PERMISSION_DENIED in production.
    // ============================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function getUserCompanyId() {
      return request.auth.token.companyId;
    }
    
    function getUserDepartmentId() {
      return request.auth.token.departmentId;
    }
    
    function getUserSupervisorId() {
      return request.auth.token.supervisorId;
    }
    
    function getUserTraineeId() {
      return request.auth.token.traineeId;
    }
    
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    function isSupervisor() {
      return getUserRole() == 'supervisor';
    }
    
    function isCoordinator() {
      return getUserRole() == 'coordinator';
    }
    
    function isTrainee() {
      return getUserRole() == 'trainee';
    }
    
    function isSupervisorOrAdmin() {
      return isSupervisor() || isAdmin();
    }
    
    function isCoordinatorOrAbove() {
      return isCoordinator() || isSupervisor() || isAdmin();
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isSupervisorOf(traineeId) {
      return isSupervisor() && exists(/databases/$(database)/documents/supervisors/$(request.auth.uid)/assignedTrainees/$(traineeId));
    }
    
    function isSupervisorOfByField(traineeId) {
      return isSupervisor() && get(/databases/$(database)/documents/trainees/$(traineeId)).data.supervisorId == request.auth.uid;
    }
    
    function isAssignedTrainee(traineeId) {
      return isTrainee() && getUserTraineeId() == traineeId;
    }
    
    function sameCompany(entityCompanyId) {
      return getUserCompanyId() == entityCompanyId;
    }
    
    function sameDepartment(entityDepartmentId) {
      return getUserDepartmentId() == entityDepartmentId;
    }
    
    function isValidRole(role) {
      return role == 'admin' || role == 'supervisor' || role == 'coordinator' || role == 'trainee';
    }
    
    // ============================================
    // USERS Collection
    // ============================================
    match /users/{userId} {
      allow read: if isSignedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        isCoordinator() ||
        isSupervisor()
      );
      
      allow create: if isSignedIn() && isAdmin() && 
        request.resource.data.keys().hasAll(['email', 'role', 'displayName']) &&
        isValidRole(request.resource.data.role);
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferences'])) ||
        (isSupervisor() && sameCompany(resource.data.companyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // ============================================
    // TRAINEES Collection
    // ============================================
    match /trainees/{traineeId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isCoordinator() ||
        isSupervisor() ||
        isAssignedTrainee(traineeId) ||
        (isTrainee() && resource.data.userId == request.auth.uid)
      );
      
      allow create: if isSignedIn() && isAdmin() &&
        request.resource.data.keys().hasAll(['userId', 'companyId', 'departmentId', 'status', 'ojtStatus', 'scheduleId']);
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isCoordinator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'supervisorId', 'companyId', 'placementType', 'externalCompanyId', 'externalCompanyName', 'status', 'updatedAt'
        ])) ||
        (isSupervisorOf(traineeId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ojtStatus', 'supervisorId', 'scheduleId'])) ||
        ((isAssignedTrainee(traineeId) || (isTrainee() && resource.data.userId == request.auth.uid)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile', 'emergencyContact']))
      );
      
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // ============================================
    // SUPERVISORS Collection
    // ============================================
    match /supervisors/{supervisorId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isCoordinator() ||
        isOwner(supervisorId) ||
        (isSupervisor() && sameCompany(resource.data.companyId))
      );
      
      allow create: if isSignedIn() && isAdmin() &&
        request.resource.data.keys().hasAll(['userId', 'companyId', 'departmentId']);
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        ((isOwner(supervisorId) || resource.data.userId == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile'])) ||
        (isCoordinator() && sameCompany(resource.data.companyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedTrainees', 'updatedAt']))
      );
      
      allow delete: if isSignedIn() && isAdmin();
      
      match /assignedTrainees/{traineeId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          isCoordinator() ||
          isOwner(supervisorId) ||
          (isSupervisor() && request.auth.uid == supervisorId) ||
          sameCompany(
            get(/databases/$(database)/documents/supervisors/$(supervisorId)).data.companyId
          )
        );
        
        allow write: if isSignedIn() && (isAdmin() || isCoordinator());
      }
    }

    // ============================================
    // COORDINATORS Collection
    // ============================================
    match /coordinators/{coordinatorId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isOwner(coordinatorId) ||
        (isCoordinator() && sameCompany(resource.data.companyId))
      );
      
      allow create: if isSignedIn() && isAdmin() &&
        request.resource.data.keys().hasAll(['userId', 'companyId', 'departmentId']);
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        ((isOwner(coordinatorId) || resource.data.userId == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile']))
      );
      
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // ============================================
    // COMPANIES Collection
    // ============================================
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isCoordinator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'verifiedBy', 'verifiedAt']))
      );
    }
    
    // ============================================
    // DEPARTMENTS Collection
    // ============================================
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }
    
    // ============================================
    // WORK_SCHEDULES Collection (C2: admin-managed via direct Firestore)
    // ============================================
    match /work_schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }
    
    // ============================================
    // OJT_SCHEDULES Collection (C2: admin-managed via direct Firestore)
    // ============================================
    match /ojt_schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }
    
    // ============================================
    // ATTENDANCE_RECORDS Collection
    // ============================================
    match /attendance_records/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        isCoordinator() ||
        isAssignedTrainee(resource.data.traineeId) ||
        (isTrainee() && resource.data.traineeId == getUserTraineeId()) ||
        (isTrainee() && resource.data.traineeId == request.auth.uid) ||
        isSupervisorOf(resource.data.traineeId) ||
        isSupervisorOfByField(resource.data.traineeId) ||
        sameCompany(resource.data.companyId)
      );
      
      allow create: if isSignedIn() && (
        (isAssignedTrainee(request.resource.data.traineeId) && request.resource.data.type == 'time_in') ||
        isSupervisorOrAdmin()
      ) && request.resource.data.keys().hasAll(['traineeId', 'type', 'timestamp', 'qrSessionId', 'deviceInfo']);
      
      // Attendance records are immutable - no updates allowed
      // Corrections are handled via correction_requests subcollection
      allow update: if false;
      
      allow delete: if false;
      
      match /correction_requests/{correctionId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          isSupervisor() ||
          isCoordinator() ||
          isAssignedTrainee(get(/databases/$(database)/documents/attendance_records/$(recordId)).data.traineeId) ||
          (isTrainee() && get(/databases/$(database)/documents/attendance_records/$(recordId)).data.traineeId == getUserTraineeId()) ||
          (isTrainee() && get(/databases/$(database)/documents/attendance_records/$(recordId)).data.traineeId == request.auth.uid) ||
          isSupervisorOf(get(/databases/$(database)/documents/attendance_records/$(recordId)).data.traineeId) ||
          isSupervisorOfByField(get(/databases/$(database)/documents/attendance_records/$(recordId)).data.traineeId)
        );
        
        allow create: if isSignedIn() && (
          isTrainee() ||
          isAssignedTrainee(get(/databases/$(database)/documents/attendance_records/$(recordId)).data.traineeId) ||
          isSupervisorOf(get(/databases/$(database)/documents/attendance_records/$(recordId)).data.traineeId) ||
          isSupervisorOfByField(get(/databases/$(database)/documents/attendance_records/$(recordId)).data.traineeId) ||
          isSupervisorOrAdmin()
        ) && request.resource.data.keys().hasAll(['requestedBy', 'reason', 'originalValue', 'proposedValue', 'status']);
        
        allow update: if isSignedIn() && (
          isAdmin() ||
          isSupervisor() ||
          isCoordinator() ||
          isSupervisorOf(get(/databases/$(database)/documents/attendance_records/$(recordId)).data.traineeId) ||
          isSupervisorOfByField(get(/databases/$(database)/documents/attendance_records/$(recordId)).data.traineeId)
        ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNotes']);
      }
    }
    
    // ============================================
    // QR_SESSIONS Collection
    // ============================================
    match /qr_sessions/{sessionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isSupervisor() && resource.data.createdBy == request.auth.uid)
      );
      
      // Only Cloud Functions can create QR sessions (via generateQRToken)
      allow create: if false;
      
      // Only Cloud Functions can update (mark as used)
      allow update: if false;
      
      allow delete: if false;
    }
    
    // ============================================
    // TASKS Collection
    // ============================================
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        isCoordinator() ||
        isAssignedTrainee(resource.data.traineeId) ||
        (isTrainee() && resource.data.traineeId == getUserTraineeId()) ||
        (isTrainee() && resource.data.traineeId == request.auth.uid) ||
        isSupervisorOf(resource.data.traineeId) ||
        isSupervisorOfByField(resource.data.traineeId) ||
        sameCompany(resource.data.companyId) ||
        (isSupervisor() && resource.data.createdBy == request.auth.uid)
      );
      
      allow create: if isSignedIn() && isSupervisorOrAdmin() &&
        request.resource.data.keys().hasAll(['traineeId', 'title', 'description', 'status', 'priority', 'dueDate', 'createdBy']);
      
      allow update: if isSignedIn() && (
        (isAssignedTrainee(resource.data.traineeId) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'progress', 'submission', 'attachments', 'updatedAt']) &&
         request.resource.data.status in ['in_progress', 'submitted']) ||
        (isSupervisorOf(resource.data.traineeId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'feedback', 'approvedAt', 'approvedBy', 'returnedBy', 'returnedAt', 'returnCount', 'updatedAt']) &&
         request.resource.data.status in ['approved', 'returned', 'archived']) ||
        isAdmin()
      );
      
      allow delete: if isSignedIn() && isAdmin();
      
      match /approvals/{approvalId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          isSupervisor() ||
          isCoordinator() ||
          isAssignedTrainee(get(/databases/$(database)/documents/tasks/$(taskId)).data.traineeId) ||
          isSupervisorOf(get(/databases/$(database)/documents/tasks/$(taskId)).data.traineeId) ||
          isSupervisorOfByField(get(/databases/$(database)/documents/tasks/$(taskId)).data.traineeId)
        );
        
        allow create: if isSignedIn() && (
          isAdmin() ||
          isSupervisor() ||
          isSupervisorOf(get(/databases/$(database)/documents/tasks/$(taskId)).data.traineeId) ||
          isSupervisorOfByField(get(/databases/$(database)/documents/tasks/$(taskId)).data.traineeId)
        );
      }
    }
    
    // ============================================
    // TASK_APPROVALS Collection (top-level)
    // ============================================
    match /task_approvals/{approvalId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        isCoordinator() ||
        isTrainee()
      );
      
      allow create: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        isSupervisorOf(resource.data.traineeId) ||
        isSupervisorOfByField(resource.data.traineeId)
      ) && request.resource.data.keys().hasAll(['taskId', 'traineeId', 'status']);
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        isCoordinator()
      );
      
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // ============================================
    // DOCUMENTS Collection
    // ============================================
    match /documents/{documentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        isCoordinator() ||
        isAssignedTrainee(resource.data.traineeId) ||
        (isTrainee() && resource.data.traineeId == getUserTraineeId()) ||
        (isTrainee() && resource.data.traineeId == request.auth.uid) ||
        isSupervisorOf(resource.data.traineeId) ||
        isSupervisorOfByField(resource.data.traineeId) ||
        sameCompany(resource.data.companyId)
      );
      
      allow create: if isSignedIn() && (
        (isAssignedTrainee(request.resource.data.traineeId) || isSupervisorOrAdmin()) &&
        request.resource.data.keys().hasAll(['traineeId', 'type', 'fileName', 'fileUrl', 'fileSize', 'mimeType', 'status'])
      );
      
      allow update: if isSignedIn() && (
        (isAssignedTrainee(resource.data.traineeId) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         resource.data.status == 'pending') ||
        (isSupervisorOf(resource.data.traineeId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNotes', 'updatedAt']) &&
         resource.data.status == 'pending') ||
        (isCoordinator() && sameCompany(resource.data.companyId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNotes', 'updatedAt'])) ||
        isAdmin()
      );
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (isAssignedTrainee(resource.data.traineeId) && resource.data.status == 'pending')
      );
    }
    
    // ============================================
    // DTRS Collection (Daily Time Records)
    // ============================================
    match /dtrs/{dtrId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        isCoordinator() ||
        isAssignedTrainee(resource.data.traineeId) ||
        (isTrainee() && resource.data.traineeId == getUserTraineeId()) ||
        (isTrainee() && resource.data.traineeId == request.auth.uid) ||
        isSupervisorOf(resource.data.traineeId) ||
        isSupervisorOfByField(resource.data.traineeId) ||
        sameCompany(resource.data.companyId)
      );
      
      // Only Cloud Functions can create/update DTRs (via calculateDTR)
      allow create: if false;
      allow update: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        isCoordinator() ||
        isSupervisorOf(resource.data.traineeId) ||
        isSupervisorOfByField(resource.data.traineeId)
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'approvedBy', 'approvedAt', 'rejectedBy', 'rejectedAt', 'reviewedBy', 'reviewedAt', 'updatedAt'
      ]);
      
      allow delete: if false;
      
      match /correction_requests/{correctionId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          isSupervisor() ||
          isCoordinator() ||
          isAssignedTrainee(get(/databases/$(database)/documents/dtrs/$(dtrId)).data.traineeId) ||
          (isTrainee() && get(/databases/$(database)/documents/dtrs/$(dtrId)).data.traineeId == getUserTraineeId()) ||
          (isTrainee() && get(/databases/$(database)/documents/dtrs/$(dtrId)).data.traineeId == request.auth.uid) ||
          isSupervisorOf(get(/databases/$(database)/documents/dtrs/$(dtrId)).data.traineeId) ||
          isSupervisorOfByField(get(/databases/$(database)/documents/dtrs/$(dtrId)).data.traineeId)
        );
        
        allow create: if isSignedIn() && (
          isTrainee() ||
          isAssignedTrainee(get(/databases/$(database)/documents/dtrs/$(dtrId)).data.traineeId) ||
          isSupervisorOf(get(/databases/$(database)/documents/dtrs/$(dtrId)).data.traineeId) ||
          isSupervisorOfByField(get(/databases/$(database)/documents/dtrs/$(dtrId)).data.traineeId)
        );
        
        allow update: if isSignedIn() && (
          isAdmin() ||
          isSupervisor() ||
          isCoordinator() ||
          isSupervisorOf(get(/databases/$(database)/documents/dtrs/$(dtrId)).data.traineeId) ||
          isSupervisorOfByField(get(/databases/$(database)/documents/dtrs/$(dtrId)).data.traineeId)
        );
      }
    }
    
    // ============================================
    // LEAVE_REQUESTS Collection
    // ============================================
    match /leave_requests/{leaveId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        isCoordinator() ||
        isAssignedTrainee(resource.data.traineeId) ||
        (isTrainee() && resource.data.traineeId == getUserTraineeId()) ||
        (isTrainee() && resource.data.traineeId == request.auth.uid) ||
        isSupervisorOf(resource.data.traineeId) ||
        isSupervisorOfByField(resource.data.traineeId) ||
        sameCompany(resource.data.companyId)
      );
      
      allow create: if isSignedIn() && (
        isAssignedTrainee(request.resource.data.traineeId) ||
        (isTrainee() && request.resource.data.traineeId == getUserTraineeId()) ||
        (isTrainee() && request.resource.data.traineeId == request.auth.uid)
      ) && request.resource.data.keys().hasAll(['traineeId', 'type', 'startDate', 'endDate', 'reason', 'status']);
      
      allow update: if isSignedIn() && (
        (isAssignedTrainee(resource.data.traineeId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']) &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled') ||
        ((isSupervisor() || isCoordinator() || isSupervisorOf(resource.data.traineeId) || isSupervisorOfByField(resource.data.traineeId)) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt', 'approvalNotes']) &&
         request.resource.data.status in ['approved', 'rejected']) ||
        isAdmin()
      );
      
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // ============================================
    // AUDIT_LOGS Collection (Write-only for system, read for admin)
    // ============================================
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      
      // Admins can write audit logs directly (fallback when Edge Function is unavailable).
      // In production, write_audit Edge Function is the primary writer via Admin SDK.
      allow create: if isSignedIn() && isAdmin();
      
      allow update: if false;
      allow delete: if false;
    }
    
    // ============================================
    // SETTINGS Collection
    // ============================================
    match /settings/{settingId} {
      allow read: if isSignedIn() && (isAdmin() || isCoordinatorOrAbove());
      allow write: if isSignedIn() && isAdmin();
    }
    
    // ============================================
    // NOTIFICATIONS Collection
    // ============================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isSupervisorOrAdmin();
      allow update: if isSignedIn() && isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    // ============================================
    // FCM_TOKENS Collection
    // ============================================
    match /fcm_tokens/{tokenId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isOwner(resource.data.userId);
      allow update: if isSignedIn() && isOwner(resource.data.userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    // ============================================
    // NOTIFICATION_PREFERENCES Collection
    // ============================================
    match /notification_preferences/{prefId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow write: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    // ============================================
    // TASK_COMMENTS Collection (subcollection of tasks)
    // ============================================
    match /task_comments/{commentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        isCoordinator() ||
        isTrainee()
      );
      
      allow create: if isSignedIn() && isOwner(resource.data.userId) &&
        request.resource.data.keys().hasAll(['taskId', 'userId', 'content']);
      
      allow update: if isSignedIn() && isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content']);
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        isOwner(resource.data.userId)
      );
    }
    
    // ============================================
    // TASK_DOCUMENTS Collection
    // ============================================
    match /task_documents/{docId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isAssignedTrainee(resource.data.traineeId) ||
        isSupervisorOf(resource.data.traineeId) ||
        isSupervisorOfByField(resource.data.traineeId) ||
        (isCoordinator() && sameCompany(resource.data.companyId))
      );
      
      allow create: if isSignedIn() && (
        isAssignedTrainee(resource.data.traineeId) ||
        isSupervisorOrAdmin()
      ) && request.resource.data.keys().hasAll(['traineeId', 'taskId', 'fileName', 'fileUrl', 'fileSize', 'mimeType']);
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (isAssignedTrainee(resource.data.traineeId) && resource.data.status != 'approved')
      );
    }
    
    // ============================================
    // PROFILE_IMAGES Collection
    // ============================================
    match /profile_images/{imageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(resource.data.userId);
      allow update: if isSignedIn() && isOwner(resource.data.userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    // ============================================
    // PLACEMENT_REQUESTS Collection
    // ============================================
    match /placement_requests/{requestId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isCoordinator() ||
        (isTrainee() && resource.data.traineeId == getUserTraineeId()) ||
        (isTrainee() && resource.data.traineeId == request.auth.uid) ||
        (isSupervisor() && sameCompany(resource.data.externalCompanyId))
      );
      
      allow create: if isSignedIn() && isTrainee() &&
        request.resource.data.keys().hasAll(['traineeId', 'traineeName', 'traineeEmail', 'externalCompanyId', 'externalCompanyName', 'status']);
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        isCoordinator()
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewerNotes', 'reviewedAt', 'updatedAt']);
      
      allow delete: if false;
    }
    
    // ============================================
    // SUPERVISOR_INVITATIONS Collection
    // ============================================
    match /supervisor_invitations/{invitationId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isCoordinator()
      );
      
      allow create: if isSignedIn() && isCoordinator() &&
        request.resource.data.keys().hasAll(['companyId', 'supervisorName', 'supervisorEmail', 'status']);
      
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // ============================================
    // DOCUMENT_REQUIREMENTS Collection
    // ============================================
    match /document_requirements/{requirementId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isCoordinator() ||
        sameCompany(resource.data.companyId)
      );
      
      allow create: if isSignedIn() && (
        isAdmin() ||
        isCoordinator()
      ) && sameCompany(request.resource.data.companyId) &&
        request.resource.data.keys().hasAll(['companyId', 'documentType', 'label', 'requiredFor', 'required', 'order']);
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        isCoordinator()
      ) && sameCompany(resource.data.companyId);
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        isCoordinator()
      ) && sameCompany(resource.data.companyId);
    }
    
    // ============================================
    // EVALUATIONS Collection
    // ============================================
    match /evaluations/{evaluationId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isCoordinator() ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid) ||
        (isTrainee() && resource.data.traineeId == getUserTraineeId()) ||
        (isTrainee() && resource.data.traineeId == request.auth.uid)
      );
      
      allow create: if isSignedIn() && (
        isAdmin() ||
        isCoordinator() ||
        isSupervisor()
      ) && sameCompany(request.resource.data.companyId) &&
        request.resource.data.keys().hasAll([
          'traineeId', 'traineeName', 'supervisorId', 'supervisorName',
          'companyId', 'type', 'status', 'period', 'ratings'
        ]);
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        isCoordinator() ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid)
      ) && sameCompany(resource.data.companyId);
      
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // ============================================
    // ANNOUNCEMENTS Collection
    // ============================================
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isCoordinator() && sameCompany(request.resource.data.companyId))
      ) && request.resource.data.keys().hasAll([
          'title', 'content', 'authorId', 'authorName', 'companyId',
          'priority', 'status', 'targetRoles', 'pinned'
        ]);
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isCoordinator() && sameCompany(resource.data.companyId))
      );
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (isCoordinator() && sameCompany(resource.data.companyId))
      );
    }
    
    // ============================================
    // Catch-all: deny by default
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}