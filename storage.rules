rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ============================================
    // Helper Functions
    // ============================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function getUserCompanyId() {
      return request.auth.token.companyId;
    }
    
    function getUserDepartmentId() {
      return request.auth.token.departmentId;
    }
    
    function getUserTraineeId() {
      return request.auth.token.traineeId;
    }
    
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    function isSupervisor() {
      return getUserRole() == 'supervisor';
    }
    
    function isCoordinator() {
      return getUserRole() == 'coordinator';
    }
    
    function isTrainee() {
      return getUserRole() == 'trainee';
    }
    
    function isSupervisorOrAdmin() {
      return isSupervisor() || isAdmin();
    }
    
    function isCoordinatorOrAbove() {
      return isCoordinator() || isSupervisor() || isAdmin();
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function sameCompany(entityCompanyId) {
      return getUserCompanyId() == entityCompanyId;
    }
    
    function isValidMimeType() {
      return request.resource.contentType.matches('^image/(jpeg|png|webp)$') ||
             request.resource.contentType == 'application/pdf' ||
             request.resource.contentType.matches('^application/(msword|vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet))$');
    }
    
    function isValidFileSize() {
      return request.resource.size <= 10 * 1024 * 1024; // 10MB
    }
    
    // Path segment {documentId} in /documents/{companyId}/{documentId}/... is the traineeId.
    function isAssignedSupervisorOfPath(companyId, traineeId) {
      return isSupervisor() && sameCompany(companyId) &&
        firestore.exists(/databases/(default)/documents/supervisors/$(request.auth.uid)/assignedTrainees/$(traineeId));
    }
    
    // Owner check for existing objects (resource is available on read/delete).
    function ownsTraineePath(companyId, traineeId) {
      return isTrainee() && sameCompany(companyId) && (
        (('owner' in resource.metadata) && resource.metadata.owner == request.auth.uid) ||
        getUserTraineeId() == traineeId
      );
    }
    
    function canReadTraineeFile(companyId, traineeId) {
      return isAdmin() ||
        (isCoordinator() && sameCompany(companyId)) ||
        isAssignedSupervisorOfPath(companyId, traineeId) ||
        ownsTraineePath(companyId, traineeId);
    }
    
    function taskAssignedToMe(taskId) {
      return firestore.exists(/databases/(default)/documents/tasks/$(taskId)) &&
        (firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.traineeId == request.auth.uid ||
         firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.traineeId == getUserTraineeId());
    }
    
    // ============================================
    // Documents Storage
    // ============================================
    match /documents/{companyId}/{documentId}/{fileName} {
      allow read: if isSignedIn() && canReadTraineeFile(companyId, documentId);
      
      allow write: if isSignedIn() && (
        (isTrainee() && getUserCompanyId() == companyId) ||
        (isSupervisor() && getUserCompanyId() == companyId) ||
        isAdmin()
      ) && isValidMimeType() && isValidFileSize();
      
      allow delete: if isSignedIn() && canReadTraineeFile(companyId, documentId);
    }
    
    // ============================================
    // Task Attachments Storage
    // ============================================
    match /tasks/{companyId}/{taskId}/{allPaths=**} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isSupervisor() && sameCompany(companyId)) ||
        (isTrainee() && sameCompany(companyId) && taskAssignedToMe(taskId))
      );
      
      allow write: if isSignedIn() && (
        (isTrainee() && getUserCompanyId() == companyId) ||
        (isSupervisor() && getUserCompanyId() == companyId) ||
        isAdmin()
      ) && isValidMimeType() && isValidFileSize();
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (isSupervisor() && getUserCompanyId() == companyId)
      );
    }
    
    // ============================================
    // Profile Images
    // ============================================
    match /profiles/{userId}/{fileName} {
      allow read: if isSignedIn();
      
      allow write: if isSignedIn() && (
        isOwner(userId) || isAdmin()
      ) && request.resource.contentType.matches('^image/(jpeg|png|webp)$') 
         && request.resource.size <= 5 * 1024 * 1024; // 5MB for profile images
      
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }
    
    // ============================================
    // QR Code Images (generated by system)
    // ============================================
    match /qr_codes/{sessionId}/{fileName} {
      allow read: if isSignedIn() && (
        isAdmin() || isSupervisor()
      );
      
      // Only Cloud Functions can write QR codes
      allow write: if false;
      
      allow delete: if false;
    }
    
    // ============================================
    // Default deny
    // ============================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}