rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ============================================
    // Helper Functions
    // ============================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return getUserData().role;
    }
    
    function getUserCompanyId() {
      return getUserData().companyId;
    }
    
    function getUserDepartmentId() {
      return getUserData().departmentId;
    }
    
    function getUserTraineeId() {
      return getUserData().traineeId;
    }
    
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    function isSupervisor() {
      return getUserRole() == 'supervisor';
    }
    
    function isCoordinator() {
      return getUserRole() == 'coordinator';
    }
    
    function isTrainee() {
      return getUserRole() == 'trainee';
    }
    
    function isSupervisorOrAdmin() {
      return isSupervisor() || isAdmin();
    }
    
    function isCoordinatorOrAbove() {
      return isCoordinator() || isSupervisor() || isAdmin();
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function sameCompany(entityCompanyId) {
      return getUserCompanyId() == entityCompanyId;
    }
    
    function isValidMimeType() {
      return request.resource.contentType.matches('^image/(jpeg|png|webp)$') ||
             request.resource.contentType == 'application/pdf' ||
             request.resource.contentType.matches('^application/(msword|vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet))$');
    }
    
    function isValidFileSize() {
      return request.resource.size <= 10 * 1024 * 1024; // 10MB
    }
    
    // ============================================
    // Documents Storage
    // ============================================
    match /documents/{companyId}/{documentId}/{fileName} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isTrainee() && getUserCompanyId() == companyId) ||
        (isSupervisor() && getUserCompanyId() == companyId) ||
        (isCoordinator() && getUserCompanyId() == companyId)
      );
      
      allow write: if isSignedIn() && (
        (isTrainee() && getUserCompanyId() == companyId) ||
        (isSupervisor() && getUserCompanyId() == companyId) ||
        isAdmin()
      ) && isValidMimeType() && isValidFileSize();
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (isTrainee() && getUserCompanyId() == companyId && request.resource.metadata.owner == request.auth.uid)
      );
    }
    
    // ============================================
    // Task Attachments Storage
    // ============================================
    match /tasks/{companyId}/{taskId}/{fileName} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isTrainee() && getUserCompanyId() == companyId) ||
        (isSupervisor() && getUserCompanyId() == companyId)
      );
      
      allow write: if isSignedIn() && (
        (isTrainee() && getUserCompanyId() == companyId) ||
        (isSupervisor() && getUserCompanyId() == companyId) ||
        isAdmin()
      ) && isValidMimeType() && isValidFileSize();
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (isSupervisor() && getUserCompanyId() == companyId)
      );
    }
    
    // ============================================
    // Profile Images
    // ============================================
    match /profiles/{userId}/{fileName} {
      allow read: if isSignedIn();
      
      allow write: if isSignedIn() && (
        isOwner(userId) || isAdmin()
      ) && request.resource.contentType.matches('^image/(jpeg|png|webp)$') 
         && request.resource.size <= 5 * 1024 * 1024; // 5MB for profile images
      
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }
    
    // ============================================
    // QR Code Images (generated by system)
    // ============================================
    match /qr_codes/{sessionId}/{fileName} {
      allow read: if isSignedIn() && (
        isAdmin() || isSupervisor()
      );
      
      // Only Cloud Functions can write QR codes
      allow write: if false;
      
      allow delete: if false;
    }
    
    // ============================================
    // Default deny
    // ============================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}